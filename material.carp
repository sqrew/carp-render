(load "Vector.carp")
(use Vector3)

(doc Material "represents the visual properties of a surface.")
(deftype Material [
  albedo (Vector3 Double)
  roughness Double
  metallic Double
  emission (Vector3 Double)
])

(defmodule Material
  (defn make [albedo roughness metallic]
    (Material.init albedo roughness metallic (Vector3.init 0.0 0.0 0.0)))

  (defn emission [albedo roughness metallic emit]
    (Material.init albedo roughness metallic emit))

  (doc default "returns a neutral grey material.")
  (defn default []
    (Material.init (Vector3.init 0.5 0.5 0.5) 0.5 0.0 (Vector3.init 0.0 0.0 0.0)))
)
